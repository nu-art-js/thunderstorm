@startuml
skinparam linetype ortho

rectangle "App Layer" {
	entity "Anchor Entity" as anchor {
		_id: UniqueId
		dbKey: string
	}
	note bottom of anchor: Any DB entity that\nneeds a conversation\n(knowledge node, task, …)
}

rectangle "ts-messaging" {
	entity "DB_Topic" as topic {
		_id: UniqueId
		anchor: DBPointer {dbKey, id}
		__access: DocumentAccess
	}
	note right of topic
		Unique: [anchor.dbKey, anchor.id]
		One topic per anchor
		__access = per-topic entity groups
	end note

	entity "DB_Message" as msg {
		_id: UniqueId
		topicId: UniqueId
		parentMessageId?: UniqueId
		text?: string
		attachments?: AssetRef[]
		mention?: Account['_id'][]
		_auditorId: string
		__access: DocumentAccess
	}
	note right of msg
		mention optional
		__access copied from Topic at create
		create gated by Topic.writers
	end note
}

rectangle "file-upload" {
	entity "DB_Asset" as asset {
		_id: UniqueId
		name: string
		mimeType: string
		key: string
	}
}

rectangle "Permissions" {
	entity "Topic entity groups" as ag {
		readers / writers / deleters / owners
	}
	note bottom of ag
		Minted per Topic._id
		Members added at Topic create
		Messages copy Topic.__access
	end note
}

rectangle "Callback" {
	entity "OnMessageMentioned" as cb {
		topic
		message
		mentionedAccountIds
	}
	note bottom of cb
		Dispatcher after create
		App registers listener
		No Persona/LLM in this lib
	end note
}

anchor ||--|| topic : "anchors (1:1)"
topic ||--o{ msg : "contains"
msg ||--o{ msg : "thread replies\n(parentMessageId)"
msg }o--o{ asset : "attachments\n(AssetRef.assetId)"
ag ..> topic : "Topic.__access"
ag ..> msg : "copy at create"
msg ..> cb : "mention.length > 0"
@enduml
