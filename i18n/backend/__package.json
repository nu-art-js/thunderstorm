{
	"name": "@nu-art/i18n-backend",
	"version": "{{THUNDERSTORM_VERSION}}",
	"description": "i18n — Backend locale catalog, overlay, resolve",
	"license": "Apache-2.0",
	"dependencies": {
		"@nu-art/i18n-shared": "?",
		"@nu-art/api-types": "?",
		"@nu-art/action-processor-backend": "?",
		"@nu-art/permissions-backend": "?",
		"@nu-art/db-api-backend": "?",
		"@nu-art/db-api-shared": "?",
		"@nu-art/ts-common": "?"
	},
	"publishConfig": {"directory": "dist", "linkDirectory": true},
	"unitConfig": {
		"output": "dist",
		"type": "typescript-lib"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		},
		"./*": {
			"types": "./*.d.ts",
			"import": "./*.js"
		}
	}
}
