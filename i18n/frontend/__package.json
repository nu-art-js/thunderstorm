		"@nu-art/ts-common": "?",
		"react": "?",
		"react-dom": "?"
	},
	"devDependencies": {
		"@types/react": "?",
		"@types/react-dom": "?"
	},
	"publishConfig": {"directory": "dist", "linkDirectory": true},
	"unitConfig": {
		"output": "dist",
