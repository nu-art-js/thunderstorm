{
  "name": "@nu-art/ws-api-backend",
  "version": "{{THUNDERSTORM_VERSION}}",
  "description": "WebSocket server module for Thunderstorm — attaches to HttpServer, typed message router, injectable auth",
  "keywords": [
    "TacB0sS",
    "websocket",
    "ws",
    "express",
    "infra",
    "nu-art",
    "ws-api",
    "thunderstorm",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:nu-art-js/thunderstorm.git",
    "directory": "_thunderstorm/ws-api/backend"
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": true
  },
  "license": "Apache-2.0",
  "author": "TacB0sS",
  "scripts": {
    "build": "tsc -p src/main/tsconfig.json && cp package.json dist/",
    "test": "npm run build && tsc -p src/test/tsconfig.json && mocha --timeout 20000 dist-test/test/test.js"
  },
  "dependencies": {
    "@nu-art/ws-api-shared": "?",
    "@nu-art/http-server": "?",
    "@nu-art/logger": "?",
    "@nu-art/ts-common": "?",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nu-art/testalot": "?",
    "@types/ws": "^8.5.13",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.0",
    "mocha": "^10.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "@types/express": "^4.17.17"
  },
  "unitConfig": {
    "type": "typescript-lib"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  }
}
